{
  "gateway": {
    "mode": "local",
    "bind": "loopback",
    "tailscale": {
      "mode": "__TAILSCALE_MODE__"
    },
    "auth": {
      "mode": "token",
      "token": "__OPENCLAW_GATEWAY_TOKEN__"
    }
  },
  "agents": {
    "defaults": {
      "workspace": "__HOME__/.openclaw/workspace-jarvis",
      "model": {
        "primary": "custom/__OLLAMA_PRIMARY_MODEL__"
      },
      "sandbox": {
        "mode": "off"
      },
      "compaction": {
        "keepRecentTokens": 8192
      },
      "mediaMaxMb": 25,
      "pdfMaxPages": 3,
      "heartbeat": {
        "target": "none"
      }
    }
  },
  "memory": {
    "search": {
      "enabled": true,
      "provider": "ollama-embeddings",
      "model": "embeddinggemma"
    }
  },
  "models": {
    "providers": {
      "custom": {
        "baseUrl": "http://127.0.0.1:11434/v1",
        "apiKey": "ollama-local-no-auth",
        "api": "openai-completions",
        "models": [
          {
            "id": "__OLLAMA_PRIMARY_MODEL__",
            "name": "Jarvis (Ollama __OLLAMA_PRIMARY_MODEL__)",
            "reasoning": false,
            "input": [
              "text"
            ],
            "contextWindow": __OLLAMA_CONTEXT_LENGTH__,
            "maxTokens": 4096
          }
        ]
      },
      "ollama-embeddings": {
        "baseUrl": "http://127.0.0.1:11434",
        "apiKey": "ollama-local-no-auth",
        "api": "ollama",
        "models": [
          {
            "id": "embeddinggemma",
            "name": "EmbeddingGemma (búsqueda en la memoria)"
          }
        ]
      }
    }
  },
  "mcp": {
    "servers": {
      "jarvis-rag": {
        "command": "__REPO_DIR__/.venv/bin/python",
        "args": [
          "__REPO_DIR__/integrations/openclaw/skills/jarvis-rag/server.py"
        ],
        "env": {
          "JARVIS_API_URL": "http://127.0.0.1:8000",
          "JARVIS_API_INTERNAL_TOKEN": "__JARVIS_API_INTERNAL_TOKEN__",
          "JARVIS_DATA_ROOT": "/srv/jarvis",
          "JARVIS_OUTBOX_DIR": "__HOME__/.openclaw/workspace-jarvis/outbox",
          "COMPOSE_PROFILES": "__COMPOSE_PROFILES__",
          "OPENPROJECT_PORT": "__OPENPROJECT_PORT__",
          "OPENPROJECT_HTTPS_PORT": "__OPENPROJECT_HTTPS_PORT__",
          "COUCHDB_PORT": "__COUCHDB_PORT__",
          "LIVESYNC_HTTPS_PORT": "__LIVESYNC_HTTPS_PORT__"
        },
        "requestTimeoutMs": 600000
      },
      "jarvis-calendar": {
        "command": "__REPO_DIR__/.venv/bin/python",
        "args": [
          "__REPO_DIR__/integrations/openclaw/skills/jarvis-calendar/server.py"
        ],
        "env": {
          "JARVIS_API_URL": "http://127.0.0.1:8000",
          "JARVIS_API_INTERNAL_TOKEN": "__JARVIS_API_INTERNAL_TOKEN__",
          "JARVIS_OWNER_TELEGRAM_ID": "__TELEGRAM_USER_ID__"
        }
      },
      "jarvis-pm": {
        "command": "__REPO_DIR__/.venv/bin/python",
        "args": [
          "__REPO_DIR__/integrations/openclaw/skills/jarvis-pm/server.py"
        ],
        "env": {
          "OPENPROJECT_URL": "http://127.0.0.1:__OPENPROJECT_PORT__",
          "OPENPROJECT_HTTPS_PORT": "__OPENPROJECT_HTTPS_PORT__",
          "JARVIS_API_URL": "http://127.0.0.1:8000",
          "JARVIS_API_INTERNAL_TOKEN": "__JARVIS_API_INTERNAL_TOKEN__",
          "JARVIS_OUTBOX_DIR": "__HOME__/.openclaw/workspace-jarvis/outbox"
        },
        "requestTimeoutMs": 300000
      },
      "jarvis-office": {
        "command": "__REPO_DIR__/.venv/bin/python",
        "args": [
          "__REPO_DIR__/integrations/openclaw/skills/jarvis-office/server.py"
        ],
        "env": {
          "JARVIS_OUTBOX_DIR": "__HOME__/.openclaw/workspace-jarvis/outbox"
        }
      },
      "jarvis-email": {
        "command": "__REPO_DIR__/.venv/bin/python",
        "args": [
          "__REPO_DIR__/integrations/openclaw/skills/jarvis-email/server.py"
        ],
        "env": {
          "JARVIS_API_URL": "http://127.0.0.1:8000",
          "JARVIS_API_INTERNAL_TOKEN": "__JARVIS_API_INTERNAL_TOKEN__",
          "JARVIS_OWNER_TELEGRAM_ID": "__TELEGRAM_USER_ID__"
        }
      }
    }
  },
  "tools": {
    "deny": [
      "code_execution",
      "browser",
      "cron",
      "nodes",
      "gateway",
      "image_generate",
      "music_generate",
      "video_generate",
      "x_search",
      "canvas",
      "sessions_spawn",
      "sessions_yield",
      "sessions_list",
      "sessions_history",
      "sessions_search",
      "sessions_send",
      "subagents",
      "agents_list",
      "session_status",
      "agents_wait",
      "sessions",
      "conversations_list",
      "conversations_send",
      "conversations_turn",
      "create_goal",
      "get_goal",
      "update_goal",
      "dashboard",
      "intent",
      "mobile_ui",
      "portal",
      "progress_card",
      "secrets",
      "transcripts",
      "tts",
      "skill_workshop",
      "ask_user",
      "terminal",
      "process",
      "web_fetch"
    ],
    "fs": {
      "workspaceOnly": true
    },
    "sandbox": {
      "tools": {
        "alsoAllow": [
          "jarvis-rag__*",
          "jarvis-calendar__*",
          "jarvis-email__*",
          "jarvis-office__*",
          "wiki_apply",
          "wiki_get",
          "wiki_lint",
          "wiki_search",
          "wiki_status"
        ]
      }
    },
    "exec": {
      "host": "gateway",
      "mode": "ask"
    },
    "web": {
      "search": {
        "provider": "searxng"
      }
    },
    "media": {
      "audio": {
        "enabled": true,
        "echoTranscript": true,
        "echoFormat": "📝 \"{transcript}\""
      },
      "models": [
        {
          "type": "cli",
          "command": "__WHISPER_CLI__",
          "args": [
            "-t",
            "__WHISPER_THREADS__",
            "-m",
            "/srv/jarvis/models/whisper/ggml-small-q5_1.bin",
            "-l",
            "auto",
            "--no-timestamps",
            "{{MediaPath}}"
          ],
          "timeoutSeconds": 120,
          "maxBytes": 2097152,
          "capabilities": [
            "audio"
          ]
        }
      ]
    }
  },
  "channels": {
    "telegram": {
      "enabled": __TELEGRAM_ENABLED__,
      "tokenFile": "__HOME__/.openclaw/secrets/telegram_bot_token",
      "dmPolicy": "allowlist",
      "allowFrom": [
        "__TELEGRAM_USER_ID__"
      ]
    },
    "msteams": {
      "enabled": false,
      "authType": "secret",
      "dmPolicy": "allowlist",
      "allowFrom": [
        "__MSTEAMS_ALLOWED_AAD_OBJECT_ID__"
      ],
      "webhook": {
        "port": 3978,
        "path": "/api/messages"
      }
    }
  },
  "commands": {
    "ownerAllowFrom": [
      "telegram:__TELEGRAM_USER_ID__"
    ]
  },
  "skills": {
    "load": {
      "extraDirs": [
        "__REPO_DIR__/integrations/openclaw/skills-terceros"
      ]
    },
    "entries": {
      "1password": { "enabled": false },
      "blogwatcher": { "enabled": false },
      "blucli": { "enabled": false },
      "camsnap": { "enabled": false },
      "coding-agent": { "enabled": false },
      "eightctl": { "enabled": false },
      "gemini": { "enabled": false },
      "gifgrep": { "enabled": false },
      "gog": { "enabled": false },
      "goplaces": { "enabled": false },
      "himalaya": { "enabled": false },
      "mcporter": { "enabled": false },
      "model-usage": { "enabled": false },
      "nano-pdf": { "enabled": false },
      "obsidian": { "enabled": false },
      "openai-whisper": { "enabled": false },
      "openai-whisper-api": { "enabled": false },
      "openhue": { "enabled": false },
      "oracle": { "enabled": false },
      "ordercli": { "enabled": false },
      "sag": { "enabled": false },
      "session-logs": { "enabled": false },
      "sherpa-onnx-tts": { "enabled": false },
      "songsee": { "enabled": false },
      "sonoscli": { "enabled": false },
      "spotify-player": { "enabled": false },
      "summarize": { "enabled": false },
      "trello": { "enabled": false },
      "video-frames": { "enabled": false },
      "xurl": { "enabled": false },
      "browser-automation": { "enabled": false },
      "canvas": { "enabled": false },
      "clawhub": { "enabled": false },
      "diagram-maker": { "enabled": false },
      "gh-issues": { "enabled": false },
      "github": { "enabled": false },
      "healthcheck": { "enabled": false },
      "meme-maker": { "enabled": false },
      "node-connect": { "enabled": false },
      "node-inspect-debugger": { "enabled": false },
      "notion": { "enabled": false },
      "python-debugpy": { "enabled": false },
      "skill-creator": { "enabled": false },
      "spike": { "enabled": false },
      "taskflow": { "enabled": false },
      "taskflow-inbox-triage": { "enabled": false },
      "tmux": { "enabled": false },
      "weather": { "enabled": false }
    }
  },
  "plugins": {
    "load": {
      "paths": [
        "__REPO_DIR__/integrations/openclaw/plugins/jarvis-menu"
      ]
    },
    "entries": {
      "jarvis-menu": {
        "enabled": true
      },
      "searxng": {
        "enabled": true,
        "config": {
          "webSearch": {
            "baseUrl": "http://127.0.0.1:8888",
            "language": "es"
          }
        }
      },
      "memory-wiki": {
        "enabled": true,
        "config": {
          "vaultMode": "bridge",
          "vault": {
            "scope": "global",
            "renderMode": "obsidian"
          },
          "obsidian": {
            "enabled": true,
            "useOfficialCli": false
          },
          "bridge": {
            "enabled": true,
            "readMemoryArtifacts": true,
            "indexDailyNotes": true,
            "indexMemoryRoot": true,
            "followMemoryEvents": true
          },
          "search": {
            "corpus": "all"
          },
          "render": {
            "preserveHumanBlocks": true,
            "createBacklinks": true,
            "createDashboards": true
          }
        }
      },
      "document-extract": {
        "enabled": true
      },
      "memory-core": {
        "config": {
          "dreaming": {
            "enabled": false
          }
        }
      }
    },
    "allow": [
      "jarvis-menu",
      "searxng",
      "telegram",
      "memory-wiki",
      "document-extract",
      "ollama"
    ]
  },
  "tts": {
    "auto": "inbound",
    "provider": "tts-local-cli",
    "providers": {
      "tts-local-cli": {
        "command": "__HOME__/.local/bin/jarvis-tts",
        "args": [
          "{{OutputPath}}",
          "{{Text}}"
        ],
        "outputFormat": "wav",
        "timeoutMs": 120000
      }
    }
  }
}
