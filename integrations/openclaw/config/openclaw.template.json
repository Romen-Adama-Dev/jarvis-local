    },
    "exec": {
      "host": "gateway",
      "security": "allowlist",
      "ask": "on-miss"
    },
    "web": {
      "search": {
        "provider": "searxng"
      }
    },
    "media": {
      "audio": {
        "enabled": true,
        "echoTranscript": true,
        "echoFormat": "📝 \"{transcript}\"",
        "models": [
          {
            "type": "cli",
            "command": "/usr/bin/whisper-cli",
            "args": [
              "-m",
              "/srv/jarvis/models/whisper/ggml-small-q5_1.bin",
              "-l",
              "auto",
              "--no-timestamps",
              "{{MediaPath}}"
            ],
            "timeoutSeconds": 120
          }
        ]
      }
    }
  },
  "channels": {
    "telegram": {
      "enabled": true,
      "tokenFile": "/home/jarvis/.openclaw/secrets/telegram_bot_token",
