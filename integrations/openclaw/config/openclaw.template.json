  "mcp": {
    "servers": {
      "jarvis-rag": {
        "command": "/home/jarvis/.local/bin/uv",
        "args": [
          "run",
          "--frozen",
          "--project",
          "/home/jarvis/jarvis-local",
          "python",
          "/home/jarvis/jarvis-local/integrations/openclaw/skills/jarvis-rag/server.py"
        ],
        "env": {
          "JARVIS_API_URL": "http://127.0.0.1:8000",
