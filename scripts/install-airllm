#!/usr/bin/env bash
set -euo pipefail

if [[ $EUID -eq 0 ]]; then
    echo "No ejecutes este script como root directamente; usa un usuario con sudo." >&2
    exit 1
fi

SERVICE_USER="${JARVIS_SERVICE_USER:-jarvis-svc}"
DEPLOY_DIR="${JARVIS_DEPLOY_DIR:-/srv/jarvis/app}"
SERVICE_DIR="${DEPLOY_DIR}/services/airllm"
MODELS_DIR="/srv/jarvis/models/airllm"
REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [[ ! -d "${SERVICE_DIR}" ]]; then
    echo "ERROR: no existe ${SERVICE_DIR}. Ejecuta primero scripts/deploy." >&2
    exit 1
fi

echo "== Directorios de modelos AirLLM =="
sudo mkdir -p "${MODELS_DIR}/hf" "${MODELS_DIR}/layered"
sudo chown -R "${SERVICE_USER}:${SERVICE_USER}" "${MODELS_DIR}"
sudo chmod 770 "${MODELS_DIR}"

echo "== Espacio disponible en ${MODELS_DIR} =="
df -h "${MODELS_DIR}" | tail -1

echo "== Sincronizando entorno Python aislado (torch cu124 + airllm, ~7 GiB la primera vez) =="
sudo -u "${SERVICE_USER}" env HOME=/srv/jarvis/data UV_CACHE_DIR=/srv/jarvis/data/uv-cache \
    bash -c "cd '${SERVICE_DIR}' && /usr/local/bin/uv sync --frozen --extra runtime --no-dev"

echo "== Instalando unidad systemd airllm.service =="
sudo cp "${REPO_DIR}/infra/systemd/airllm.service" /etc/systemd/system/airllm.service
sudo systemctl daemon-reload
sudo systemctl enable --now airllm.service

echo "== Estado =="
sleep 2
sudo systemctl --no-pager --lines=5 status airllm.service || true
echo
echo "Comprueba la carga del modelo con: curl -s http://127.0.0.1:11500/health | jq"
echo "El modelo se configura con AIRLLM_MODEL en ${DEPLOY_DIR}/.env (ver docs/AIRLLM.md)."
