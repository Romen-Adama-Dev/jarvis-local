#!/usr/bin/env bash
set -euo pipefail

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "${REPO_DIR}"

if ! systemctl is-active --quiet ollama; then
    echo "ERROR: el servicio ollama no está activo. Ejecuta scripts/install-ollama primero." >&2
    exit 1
fi

exec uv run --frozen python scripts/_benchmark_models.py "$@"
