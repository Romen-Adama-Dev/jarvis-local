#!/usr/bin/env bash
set -euo pipefail

if command -v docker >/dev/null 2>&1; then
    echo "Docker ya está instalado ($(docker --version)), se omite instalación de paquetes."
else
    echo "== Repositorio oficial de Docker =="
    sudo apt-get update -qq
    sudo apt-get install -y ca-certificates curl gnupg
    sudo install -m 0755 -d /etc/apt/keyrings
    if [ ! -f /etc/apt/keyrings/docker.asc ]; then
        sudo curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
        sudo chmod a+r /etc/apt/keyrings/docker.asc
    fi

    FINGERPRINT_EXPECTED="9DC85822 9FC7DD38 854AE2D8 8D81803C 0EBFCD88"
    FINGERPRINT_ACTUAL=$(gpg --show-keys --with-fingerprint --with-colons /etc/apt/keyrings/docker.asc | awk -F: '/^fpr:/ {print $10; exit}')
    if [[ "${FINGERPRINT_ACTUAL}" != "${FINGERPRINT_EXPECTED// /}" ]]; then
        echo "ERROR: la huella de la clave GPG de Docker no coincide con la esperada." >&2
        echo "Esperada: ${FINGERPRINT_EXPECTED}" >&2
        echo "Obtenida: ${FINGERPRINT_ACTUAL}" >&2
        exit 1
    fi

    ARCH=$(dpkg --print-architecture)
    CODENAME=$(. /etc/os-release && echo "${VERSION_CODENAME}")
    echo "deb [arch=${ARCH} signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu ${CODENAME} stable" | sudo tee /etc/apt/sources.list.d/docker.list >/dev/null
    sudo apt-get update -qq
    sudo apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-ce-rootless-extras docker-compose-plugin
fi

HUMAN_USER="${SUDO_USER:-$USER}"
if ! id -nG "${HUMAN_USER}" | tr ' ' '\n' | grep -qx docker; then
    sudo usermod -aG docker "${HUMAN_USER}"
    echo "Añadido ${HUMAN_USER} al grupo docker (relogin necesario)."
fi

sudo docker version
sudo docker compose version
