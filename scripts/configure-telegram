#!/usr/bin/env bash
set -euo pipefail

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CONFIG="$HOME/.openclaw/openclaw.json"
SECRETS_DIR="$HOME/.openclaw/secrets"
TEMPLATE="$REPO_DIR/integrations/openclaw/config/openclaw.template.json"
export PATH="$HOME/.npm-global/bin:$PATH"

TELEGRAM_BOT_TOKEN="${TELEGRAM_BOT_TOKEN:-}"
TELEGRAM_USER_ID="${TELEGRAM_USER_ID:-}"
JARVIS_API_INTERNAL_TOKEN="${JARVIS_API_INTERNAL_TOKEN:-}"

if [[ -z "$TELEGRAM_BOT_TOKEN" ]]; then
  read -rsp "Token del bot de Telegram (BotFather): " TELEGRAM_BOT_TOKEN; echo
fi
if [[ -z "$TELEGRAM_USER_ID" ]]; then
  read -rp "Telegram user ID autorizado (numérico): " TELEGRAM_USER_ID
fi
if [[ -z "$JARVIS_API_INTERNAL_TOKEN" ]]; then
  JARVIS_API_INTERNAL_TOKEN=$(grep -oP '(?<=^JARVIS_API_INTERNAL_TOKEN=).*' "$REPO_DIR/.env" 2>/dev/null || true)
fi
if [[ -z "$JARVIS_API_INTERNAL_TOKEN" ]]; then
  echo "Falta JARVIS_API_INTERNAL_TOKEN (defínelo en el entorno o en $REPO_DIR/.env)" >&2
  exit 1
fi

env_value() { grep -oP "(?<=^$1=).*" "$REPO_DIR/.env" 2>/dev/null || true; }
OLLAMA_PRIMARY_MODEL="${OLLAMA_PRIMARY_MODEL:-$(env_value OLLAMA_PRIMARY_MODEL)}"
OLLAMA_CONTEXT_LENGTH="${OLLAMA_CONTEXT_LENGTH:-$(env_value OLLAMA_CONTEXT_LENGTH)}"
if [[ -z "$OLLAMA_PRIMARY_MODEL" || -z "$OLLAMA_CONTEXT_LENGTH" ]]; then
  echo "Faltan OLLAMA_PRIMARY_MODEL/OLLAMA_CONTEXT_LENGTH en $REPO_DIR/.env (ejecuta scripts/select-models)" >&2
  exit 1
fi
if ! ollama list 2>/dev/null | grep -q "^${OLLAMA_PRIMARY_MODEL}[[:space:]]"; then
  echo "AVISO: el modelo ${OLLAMA_PRIMARY_MODEL} no está descargado en Ollama (scripts/select-models --pull)." >&2
fi

WHISPER_CLI="$(command -v whisper-cli || true)"
if [[ -z "$WHISPER_CLI" ]]; then
  echo "AVISO: whisper-cli no está instalado (scripts/install-openclaw); las notas de voz no funcionarán." >&2
  WHISPER_CLI="/usr/local/bin/whisper-cli"
fi

echo "== Guardando token del bot fuera de Git =="
mkdir -p "$SECRETS_DIR"
chmod 700 "$SECRETS_DIR"
printf '%s' "$TELEGRAM_BOT_TOKEN" > "$SECRETS_DIR/telegram_bot_token"
chmod 600 "$SECRETS_DIR/telegram_bot_token"

echo "== Generando openclaw.json desde la plantilla =="
if [[ -f "$CONFIG" ]]; then
  cp "$CONFIG" "$CONFIG.bak.$(date +%Y%m%d%H%M%S)"
fi
sed -e "s/__TELEGRAM_USER_ID__/${TELEGRAM_USER_ID}/g" \
    -e "s/__JARVIS_API_INTERNAL_TOKEN__/${JARVIS_API_INTERNAL_TOKEN}/g" \
    -e "s|__HOME__|${HOME}|g" \
    -e "s|__REPO_DIR__|${REPO_DIR}|g" \
    -e "s|__OLLAMA_PRIMARY_MODEL__|${OLLAMA_PRIMARY_MODEL}|g" \
    -e "s/__OLLAMA_CONTEXT_LENGTH__/${OLLAMA_CONTEXT_LENGTH}/g" \
    -e "s|__WHISPER_CLI__|${WHISPER_CLI}|g" \
    "$TEMPLATE" > "$CONFIG"
chmod 600 "$CONFIG"

echo "== Token del gateway y validación =="
openclaw doctor --fix --non-interactive >/dev/null || true

echo "== Política de ejecución (allowlist + aprobación en Telegram) =="
openclaw exec-policy set --host gateway --security allowlist --ask on-miss --ask-fallback deny >/dev/null
for c in /usr/bin/uptime /usr/bin/uname /usr/bin/df /usr/bin/free /usr/bin/date /usr/bin/whoami /usr/bin/ls /usr/bin/du /usr/bin/ps /usr/bin/nvidia-smi /usr/local/bin/ollama; do
  openclaw approvals allowlist add --agent main "$c" >/dev/null 2>&1 || true
done

echo "== Correo/calendario: wrapper gog de solo lectura en allowlist =="
install -m 755 "$REPO_DIR/integrations/openclaw/config/gog-read" "$HOME/.local/bin/gog-read"
openclaw approvals allowlist add --agent main "$HOME/.local/bin/gog-read" >/dev/null 2>&1 || true

echo "== Reiniciando gateway =="
systemctl --user restart openclaw-gateway.service
sleep 5
systemctl --user is-active openclaw-gateway.service

echo "Telegram configurado. Escribe /start al bot desde la cuenta autorizada."
