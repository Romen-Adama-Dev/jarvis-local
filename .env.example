# Copia este archivo a .env: `cp .env.example .env`. Nunca commitees el .env real.
#
# Con docker compose solo es obligatorio rellenar TELEGRAM_BOT_TOKEN y
# TELEGRAM_AUTHORIZED_USER_IDS (sección Telegram). Los secretos vacíos los genera el
# servicio init en el primer arranque y los modelos se eligen según la VRAM; si rellenas
# un valor aquí, tiene prioridad. Ver docs/DOCKER.md.

ENVIRONMENT=production
LOG_LEVEL=info

# --- Docker compose ---
# Perfiles opcionales separados por comas: tailscale, livesync, pm, vault, backup,
# assistant, automation, webui, monitoring.
COMPOSE_PROFILES=
# Reutilizar datos de una instalación previa en el host (vacío = volúmenes de Docker):
# modelos de Ollama y estado de OpenClaw (~/.openclaw), con el UID/GID de su dueño.
OLLAMA_MODELS_PATH=
OPENCLAW_STATE_PATH=
JARVIS_UID=1000
JARVIS_GID=1000
# Peticiones simultáneas en Ollama y secciones de un documento generadas a la vez.
OLLAMA_NUM_PARALLEL=4
DOCGEN_CONCURRENCY=4
# Token de la interfaz web/CLI de OpenClaw (vacío = generado por init).
OPENCLAW_GATEWAY_TOKEN=
# Perfil tailscale: interfaz web de OpenClaw en https://<TAILSCALE_HOSTNAME>.<tailnet>.ts.net.
# Clave de https://login.tailscale.com/admin/settings/keys para el primer arranque (vacía =
# inicia sesión con el enlace de `docker compose logs tailscale`). El nodo queda guardado
# en el volumen tailscale_state.
TS_AUTHKEY=
# Segundos que OpenClaw espera a Tailscale al arrancar (tras un reinicio del servidor
# Docker no respeta el orden). Sin sesión iniciada en Tailscale, cada arranque de
# OpenClaw tarda esto de más: inicia sesión o quita el perfil tailscale.
TAILSCALE_WAIT_SECONDS=180
TAILSCALE_HOSTNAME=jarvis
# Perfil livesync (docs/OBSIDIAN.md): Obsidian sincronizado por Tailscale. Contraseñas
# vacías = generadas por init.
LIVESYNC_HTTPS_PORT=8443
COUCHDB_PASSWORD=
LIVESYNC_PASSPHRASE=
LIVESYNC_URI_PASSPHRASE=
# Perfil pm (docs/OPENPROJECT.md): OpenProject en http://127.0.0.1:OPENPROJECT_PORT y, con
# tailscale, en https://<nombre>.ts.net:OPENPROJECT_HTTPS_PORT. Entras con el usuario
# "admin" y la contraseña de /run/jarvis/openproject_admin_password (vacía = generada por
# init). El nombre del admin solo se aplica al crear la base de datos; su correo (vacío =
# el de Jarvis, MAIL_FROM o MAIL_USERNAME) se aplica en cada arranque. OpenProject envía
# sus correos (avisos, invitaciones a reuniones) por el SMTP de Jarvis (MAIL_*).
OPENPROJECT_PORT=8090
OPENPROJECT_HTTPS_PORT=8445
OPENPROJECT_LANGUAGE=es
OPENPROJECT_ADMIN_NAME=
OPENPROJECT_ADMIN_MAIL=
OPENPROJECT_ADMIN_PASSWORD=

# --- El propietario (quién eres para Jarvis) ---
# Tu nombre tal como quieres verlo en las notas de Obsidian (une sus variantes en las
# actas) y como te llamará el agente. Vacío = "mi usuario".
JARVIS_OWNER_NAME=
# Nombre completo y zona horaria para el workspace del agente (USER.md, IDENTITY.md).
# Vacíos = JARVIS_OWNER_NAME y CALENDAR_TIMEZONE. Ver docs/OPENCLAW.md.
JARVIS_OWNER_FULL_NAME=
JARVIS_OWNER_TIMEZONE=

# --- Red de conocimiento en Obsidian (docs/OBSIDIAN.md) ---
KNOWLEDGE_REFRESH_SECONDS=600

# --- RAG ---
# Reranker: el multilingüe jinaai/jina-reranker-v2-base-multilingual ordena mejor en
# español, pero es CC-BY-NC-4.0 (solo uso no comercial).
RAG_RERANKER_MODEL=BAAI/bge-reranker-base

# --- Actas de reunión (docs/ACTAS.md) ---
# Modelo de faster-whisper: large-v3-turbo en GPU (~2 min por hora de audio); en CPU usa
# small o medium. device: auto, cuda o cpu.
MEETINGS_WHISPER_MODEL=large-v3-turbo
MEETINGS_WHISPER_DEVICE=auto
MEETINGS_LANGUAGE=es
MEETINGS_MAX_UPLOAD_MB=500

# --- PostgreSQL ---
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=jarvis
POSTGRES_USER=jarvis
# Vacío = generada por init (docker compose) o por scripts/quickstart (host).
POSTGRES_PASSWORD=

# --- Qdrant ---
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_COLLECTION=jarvis_documents
# Reranker local (cross-encoder BAAI/bge-reranker-base vía FastEmbed) sobre los
# candidatos de la fusión híbrida RRF antes de construir el contexto. ~1GB de
# descarga la primera vez, cacheado junto a los modelos de embeddings.
RAG_RERANKER_ENABLED=true

# --- Redis ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

# --- Almacenamiento ---
JARVIS_DATA_DIR=/srv/jarvis/data
JARVIS_DOCUMENTS_DIR=/srv/jarvis/documents
JARVIS_MODELS_DIR=/srv/jarvis/models
JARVIS_BACKUPS_DIR=/srv/jarvis/backups
JARVIS_LOGS_DIR=/srv/jarvis/logs

# --- Ollama ---
# Ver docs/MODELS.md (franjas por VRAM, scripts/select-models) y
# docs/BENCHMARKS.md (metodología y resultados medidos) para la elección.
OLLAMA_HOST=http://127.0.0.1:11434
# Vacíos = elección automática según la VRAM (scripts/select-models, docs/MODELS.md).
# Modelo rápido (consultas normales /ask, clasificación, resumen) y modelo más
# potente (contextos RAG grandes; no confundir con /deep -> AirLLM).
OLLAMA_PRIMARY_MODEL=
OLLAMA_POWERFUL_MODEL=
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# true = al arrancar, ollama-pull borra los modelos que no sean el principal, el potente
# ni embeddinggemma (los que hayas descargado a mano también).
OLLAMA_PRUNE_UNUSED=false
# Ventana de contexto de Ollama (vacío = la del nivel elegido).
OLLAMA_CONTEXT_LENGTH=
# Fija un nivel concreto para saltarte la detección de VRAM (p. ej. vram_21000).
JARVIS_MODEL_TIER=

# --- AirLLM (modo /deep; ver docs/AIRLLM.md) ---
# Habilita el modo profundo solo tras instalar el servicio con scripts/install-airllm.
AIRLLM_ENABLED=false
AIRLLM_SERVICE_URL=http://127.0.0.1:11500
# Modelo HF a servir por capas. Sin disco secundario, usa un modelo pequeño de
# validación; los modelos grandes requieren montar un disco en /srv/jarvis/models.
AIRLLM_MODEL=unset-hasta-benchmark
AIRLLM_MAX_CONCURRENCY=1
AIRLLM_TIMEOUT_SECONDS=3500
# Variables propias del servicio (prefijo AIRLLM_, leídas del mismo .env):
AIRLLM_MODELS_DIR=/srv/jarvis/models/airllm
# auto resuelve a cuda si hay GPU. En GPU el prefill de un contexto RAG largo es
# una sola pasada (~2 min); en CPU ese mismo prefill supera los timeouts (~70 min
# medidos, ver docs/BENCHMARKS.md). La convivencia con Ollama en una GPU de 8 GiB
# la gestiona el worker (AIRLLM_RELEASE_OLLAMA_VRAM): descarga Ollama de VRAM
# antes de cada generación deep, desaloja mediante un guardián periódico cualquier
# modelo que Ollama cargue durante la generación (un /ask concurrente provocaba
# CUDA OOM), reintenta una vez la consulta si aun así falla, y al terminar recarga
# limpio lo que estaba cargado. El servicio libera su caché CUDA tras cada
# generación. Usa cpu solo si no hay GPU compatible con torch.
# Con VRAM para ambos (p. ej. L4 de 23 GB) pon AIRLLM_RELEASE_OLLAMA_VRAM=false.
AIRLLM_DEVICE=auto
AIRLLM_RELEASE_OLLAMA_VRAM=true
AIRLLM_COMPRESSION=
AIRLLM_MAX_SEQ_LEN=4096
AIRLLM_MIN_FREE_GB=15
AIRLLM_MAX_MODEL_DOWNLOAD_GB=12
AIRLLM_GENERATION_TIMEOUT_SECONDS=3300
# Tope de tokens por respuesta deep, medido en GPU: prefill ~2 min + ~13 s/token
# → 128 tokens ≈ 30 min (ver docs/BENCHMARKS.md).
# Timeouts escalonados por intento: servicio (3300) < cliente del worker (3500);
# el arq job_timeout (7500) cubre el intento inicial más un reintento.
AIRLLM_MAX_NEW_TOKENS_DEFAULT=128

# --- Telegram / OpenClaw ---
TELEGRAM_BOT_TOKEN=change-me
TELEGRAM_AUTHORIZED_USER_IDS=change-me
OPENCLAW_GATEWAY_HOST=127.0.0.1
OPENCLAW_GATEWAY_PORT=8899

# --- Correo y calendario (ver docs/EMAIL.md y docs/CALENDAR.md) ---
# Rellénalo con scripts/configure-mail. imap/caldav funcionan con cualquier
# proveedor estándar y una contraseña de aplicación (Gmail, iCloud, Fastmail,
# Nextcloud...); msgraph usa Microsoft 365 y requiere Azure (sección siguiente).
MAIL_PROVIDER=imap
IMAP_HOST=
IMAP_PORT=993
IMAP_MAILBOX=INBOX
SMTP_HOST=
SMTP_PORT=587
# starttls (puerto 587) o ssl (puerto 465)
SMTP_SECURITY=starttls
MAIL_USERNAME=
MAIL_PASSWORD=
# Remitente; vacío = MAIL_USERNAME
MAIL_FROM=
# caldav, openproject (las reuniones de OpenProject, perfil pm; recomendado con Gmail, que
# no admite CalDAV con contraseña de aplicación) o msgraph. docs/CALENDAR.md.
CALENDAR_PROVIDER=caldav
# Con openproject: proyecto donde van las reuniones que no son de ningún proyecto.
OPENPROJECT_CALENDAR_PROJECT=Agenda
CALDAV_URL=
# Vacíos = los del correo
CALDAV_USERNAME=
CALDAV_PASSWORD=
# Nombre visible del calendario; vacío = el primero de la cuenta
CALDAV_CALENDAR_NAME=
CALENDAR_TIMEZONE=Europe/Madrid

# --- Microsoft Graph (solo con MAIL_PROVIDER/CALENDAR_PROVIDER=msgraph) ---
# OAuth2 (device code) + cliente HTTP para Graph, ver docs/MSGRAPH.md.
# client_id/tenant_id salen de un registro de app Azure AD manual del
# propietario (público/nativo); rellénalos ejecutando scripts/configure-msgraph.
MSGRAPH_CLIENT_ID=change-me
MSGRAPH_TENANT_ID=change-me
# Ruta de la caché de tokens de MSAL, fuera del repo, permisos 600.
MSGRAPH_TOKEN_CACHE_PATH=/home/jarvis/.openclaw/secrets/msgraph_token_cache.json

# --- Copias de seguridad (perfil backup, docs/BACKUP.md) ---
# Carpeta del host (mejor en otro disco); cada copia contiene secretos.
BACKUP_PATH=./backups
# Hora local (JARVIS_OWNER_TIMEZONE, CALENDAR_TIMEZONE o UTC) de la copia diaria.
BACKUP_TIME=03:30
BACKUP_KEEP=7

# --- Jarvis API ---
JARVIS_API_HOST=127.0.0.1
JARVIS_API_PORT=8000
# Vacío = generado por init (docker compose) o por scripts/quickstart (host).
JARVIS_API_INTERNAL_TOKEN=

# --- Seguridad ---
MAX_UPLOAD_MB=50
# Holgado a propósito: con un modelo local grande cada turno del agente tarda ~1 min,
# y el "sí" del usuario llega varios turnos después del borrador.
CONFIRMATION_TTL_SECONDS=600
RATE_LIMIT_PER_MINUTE=30

# SearXNG (perfil assistant): búsqueda web autohosteada para OpenClaw
SEARXNG_PORT=8888
# Vacío = generado por init (docker compose) o por scripts/quickstart (host).
SEARXNG_SECRET=

# --- Monitorización (perfil monitoring, docs/MONITORING.md) ---
# Grafana en http://127.0.0.1:3000 (usuario admin); alertas por Telegram con el bot de
# arriba al primer ID de TELEGRAM_AUTHORIZED_USER_IDS.
GRAFANA_PORT=3000
# Vacío = generada por init; queda en el volumen jarvis_runtime (grafana_admin_password).
GRAFANA_ADMIN_PASSWORD=
PROMETHEUS_RETENTION=30d
