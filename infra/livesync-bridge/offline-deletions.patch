+    // Files deleted while the bridge was stopped never produce a watcher event, so they
+    // stayed in CouchDB (and on every other device) forever. Every file the bridge has
+    // seen has a file-stat entry; one whose file is gone now was deleted offline.
+    // Safety net: if most known files are missing (empty or unmounted directory, partial
+    // restore) nothing is deleted.
+    async scanOfflineDeletions(seen: Set<string>) {
+        const prefix = this._getKey("file-stat-");
+        const known: string[] = [];
+        for (let i = 0; i < localStorage.length; i++) {
+            const key = localStorage.key(i);
+            if (key?.startsWith(prefix)) known.push(key.substring(prefix.length));
+        }
+        const missing: string[] = [];
+        for (const lp of known) {
+            if (seen.has(lp)) continue;
+            const stat = await Deno.stat(this.toStoragePath(lp)).catch(() => null);
+            if (!stat) missing.push(lp);
+        }
+        if (missing.length == 0) return;
+        const limit = Math.max(this.config.offlineDeletionLimit ?? 0.5, 0);
+        if (missing.length > known.length * limit) {
+            this.normalLog(`Offline deletions: ${missing.length} of ${known.length} known files are missing; not propagating (offlineDeletionLimit=${limit})`, LOG_LEVEL_NOTICE);
+            return;
+        }
+        this.normalLog(`Offline deletions detected: ${missing.length}`);
+        for (const lp of missing) {
+            this.debugLog(`Offline deletion detected: ${lp}`);
+            await this.dispatchDeleted(this.toStoragePath(lp));
+        }
+    }
