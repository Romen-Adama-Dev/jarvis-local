#!/usr/bin/env bash
# Servicio "init" de docker compose (primer paso de cada arranque): genera los secretos
# que falten y elige los modelos de Ollama según la VRAM. Todo queda en el volumen
# jarvis_runtime (/run/jarvis), que leen el resto de servicios al arrancar, así que no
# hace falta rellenar secretos a mano en .env. Lo que sí esté definido en .env tiene
# prioridad (una instalación existente conserva sus secretos). Idempotente.
set -euo pipefail

RUNTIME_DIR="${JARVIS_RUNTIME_DIR:-/run/jarvis}"
mkdir -p "$RUNTIME_DIR"
# Legibles por el resto de contenedores (cada imagen corre con su propio UID); el
# volumen solo se monta en los servicios de Jarvis.
umask 022

is_placeholder() { [[ -z "$1" || "$1" == change-me || "$1" == generar-con-openssl-rand-hex-32 ]]; }

ensure_secret() {
  local name="$1" env_value="$2" bytes="$3" file="$RUNTIME_DIR/$1" suffix="${4:-}"
  # La contraseña de PostgreSQL ya está grabada en la base de datos existente: cualquier
  # valor de .env se respeta, también el antiguo "change-me" de .env.example.
  if [[ "$name" == postgres_password && -n "$env_value" ]] || ! is_placeholder "$env_value"; then
    printf '%s' "$env_value" >"$file"
  elif [[ ! -s "$file" ]]; then
    python -c "import secrets, sys; sys.stdout.write(secrets.token_hex($bytes) + '$suffix')" >"$file"
    echo "secreto generado: $name"
  fi
}

ensure_secret postgres_password "${POSTGRES_PASSWORD:-}" 24
ensure_secret jarvis_api_internal_token "${JARVIS_API_INTERNAL_TOKEN:-}" 24
ensure_secret searxng_secret "${SEARXNG_SECRET:-}" 32
ensure_secret openclaw_gateway_token "${OPENCLAW_GATEWAY_TOKEN:-}" 24
# Perfil livesync: CouchDB, cifrado de extremo a extremo del vault y Setup URI.
ensure_secret couchdb_password "${COUCHDB_PASSWORD:-}" 24
ensure_secret livesync_passphrase "${LIVESYNC_PASSPHRASE:-}" 24
ensure_secret livesync_uri_passphrase "${LIVESYNC_URI_PASSPHRASE:-}" 16
# Perfil pm (OpenProject): firma de sesiones, base de datos, admin web y clave de API que
# openproject-setup registra para el usuario Jarvis y usa el servidor MCP jarvis-pm.
ensure_secret openproject_secret_key_base "${OPENPROJECT_SECRET_KEY_BASE:-}" 64
ensure_secret openproject_db_password "${OPENPROJECT_DB_PASSWORD:-}" 24
# La del admin web cumple la política de contraseñas de OpenProject (mayúsculas y símbolos).
ensure_secret openproject_admin_password "${OPENPROJECT_ADMIN_PASSWORD:-}" 12 "-Jv"
ensure_secret openproject_api_key "${OPENPROJECT_API_KEY:-}" 32

MODELS_ENV="$RUNTIME_DIR/models.env"
if [[ -n "${OLLAMA_PRIMARY_MODEL:-}" ]]; then
  cat >"$MODELS_ENV" <<EOF
OLLAMA_PRIMARY_MODEL=${OLLAMA_PRIMARY_MODEL}
OLLAMA_POWERFUL_MODEL=${OLLAMA_POWERFUL_MODEL:-$OLLAMA_PRIMARY_MODEL}
OLLAMA_CONTEXT_LENGTH=${OLLAMA_CONTEXT_LENGTH:-32768}
EOF
  echo "modelos fijados en .env: ${OLLAMA_PRIMARY_MODEL}"
else
  : >"$MODELS_ENV"
  JARVIS_ENV_FILE="$MODELS_ENV" /app/scripts/select-models
  # Lo fijado en .env manda también sobre el nivel elegido: los servicios leen primero su
  # entorno, y ollama/ollama-pull solo este archivo.
  for var in OLLAMA_POWERFUL_MODEL OLLAMA_CONTEXT_LENGTH; do
    if [[ -n "${!var:-}" ]]; then
      sed -i "/^${var}=/d" "$MODELS_ENV"
      printf '%s=%s\n' "$var" "${!var}" >>"$MODELS_ENV"
    fi
  done
fi

# Volúmenes de Tailscale (perfil tailscale): tailscaled corre con el UID de openclaw.
for dir in /var/lib/tailscale /var/run/tailscale; do
  if [[ -d "$dir" ]]; then
    chown "${JARVIS_UID:-1000}:${JARVIS_GID:-1000}" "$dir"
    chmod 700 "$dir"
  fi
done

# Entrada de /etc/passwd para el UID de Jarvis en imágenes que no la traen: ssh se niega a
# funcionar sin ella ("No user exists for uid"), y vault-sync hace push por SSH.
printf 'root:x:0:0:root:/root:/bin/sh\njarvis:x:%s:%s:Jarvis:/tmp:/bin/sh\n' \
  "${JARVIS_UID:-1000}" "${JARVIS_GID:-1000}" >"$RUNTIME_DIR/passwd"
