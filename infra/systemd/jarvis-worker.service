[Unit]
Description=Jarvis Local Worker (arq)
After=network-online.target docker.service jarvis-api.service
Wants=network-online.target docker.service

[Service]
Type=simple
User=jarvis-svc
Group=jarvis-svc
WorkingDirectory=/srv/jarvis/app
Environment=HOME=/srv/jarvis/app
Environment=UV_CACHE_DIR=/srv/jarvis/data/uv-cache
EnvironmentFile=/srv/jarvis/app/.env
ExecStart=/usr/local/bin/uv run --frozen arq apps.worker.jarvis_worker.main.WorkerSettings
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/jarvis/data /srv/jarvis/documents /srv/jarvis/models /srv/jarvis/logs
StandardOutput=append:/srv/jarvis/logs/jarvis-worker.log
StandardError=append:/srv/jarvis/logs/jarvis-worker.error.log

[Install]
WantedBy=multi-user.target
